// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// schema.prisma

// ==========================================
// ENUMS
// ==========================================
enum UserRole {
  USER
  OWNER
  TENANT
  MANAGER
  ADMIN
}

enum EmploymentType {
  CDI
  CDD
  INTERIM
  STAGE
  OTHER
}

enum PropertyType {
  BUILDING
  DUPLEX
  APARTMENT
  VILLA
  LOW_HOUSE
  LAND
  OTHER
}

enum PropertyStatus {
  AVAILABLE
  FOR_RENT
  MAINTENANCE
  UNAVAILABLE
}

enum RentalType {
  STUDIO
  STORE
  APARTMENT
  VILLA
}

enum RentalStatus {
  AVAILABLE
  BOOKED
  OCCUPIED
  MAINTENANCE
}

enum LeaseType {
  COMMERCIAL_LEASE
  RESIDENTIAL_LEASE
  OTHER
}

enum ContractStatus {
  PENDING
  ACTIVE
  TERMINATED
  EXPIRED
}

enum InvoiceType {
  RENT
  DEPOSIT
  CHARGES
  PENALTY
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

enum PaymentProvider {
  STRIPE
  MOBILE_MONEY
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILURE
  CANCELLED
}

enum ExpenseType {
  MAINTENANCE
  REPAIR
  TAX
  INSURANCE
  UTILITY
  OTHER
}

enum ExpenseStatus {
  PENDING
  PAID
  CANCELED
}

////////////////////// OPTIMISED ////////////////////

// ============================================================================
// USER TABLE (Central)
// ============================================================================
model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  role     UserRole @default(USER) // On définit le rôle DÈS la création

  // --- Champs Communs (Centralisés) ---
  firstName   String
  lastName    String
  phoneNumber String?
  civility    String?
  dateOfBirth DateTime?
  address     String? // Adresse actuelle de résidence
  pictureUrl  String?

  // Informations professionnelles (communes à Owner/Tenant/Employee)
  workPlace  String?
  occupation String?

  // Documents d'identité (Communs)
  identityDocumentNumber String?
  identityDocumentType   String?
  identityDeliveryCity   String?
  identityDeliveryDate   DateTime?
  identityExpiryDate     DateTime?

  // Personne à contacter (Commun)
  pacLastName    String?
  pacFirstName   String?
  pacPhoneNumber String?

  // Système
  isActive     Boolean  @default(true)
  refreshToken String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations Profil (One-to-One)
  ownerProfile   Owner?
  managerProfile Manager?
  tenantProfile  Tenant?

  // Relations Directes
  recordedExpenses Expense[] @relation("UserExpenses")

  @@map("users")
}

// ============================================================================
// PROFILE TABLES (Spécifiques)
// ============================================================================

model Owner {
  id     Int @id @default(autoincrement())
  userId Int @unique

  // Données spécifiques au propriétaire (ex: infos bancaires pour versement)
  // Si tu n'as pas de champs spécifiques pour l'instant, cette table sert
  // de marqueur pour dire "Cet utilisateur est un propriétaire".

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts  Contract[]
  properties Property[]

  @@map("owners")
}

model Manager {
  id     Int @id @default(autoincrement())
  userId Int @unique

  // --- Données Spécifiques Employé ---
  position        String
  hireDate        DateTime       @default(now())
  terminationDate DateTime?
  employmentType  EmploymentType @default(CDI)
  // -----------------------------------

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedProperties Property[] @relation("PropertyManager")
  managedContracts  Contract[] @relation("ContractManager")

  @@map("managers")
}

model Tenant {
  id     Int @id @default(autoincrement())
  userId Int @unique

  // --- Données Spécifiques Locataire ---
  oldAddress String? // Adresse avant d'emménager (utile pour l'étude de dossier)
  // -------------------------------------

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts Contract[]
  invoices  Invoice[]

  @@map("tenants")
}

// ============================================================================
// REAL ESTATE MODELS
// ============================================================================

model Property {
  id            Int            @id @default(autoincrement())
  ownerId       Int
  managerId     Int? // Optionnel: un bien peut ne pas avoir de gestionnaire dédié
  address       String
  description   String?        @db.Text
  type          PropertyType
  propertyValue Float
  status        PropertyStatus @default(AVAILABLE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  owner   Owner     @relation(fields: [ownerId], references: [id])
  manager Manager? @relation("PropertyManager", fields: [managerId], references: [id])

  rentals   Rental[]
  contracts Contract[]
  expenses  Expense[]

  @@map("properties")
}

model Rental {
  id          Int          @id @default(autoincrement())
  propertyId  Int
  name        String // Ex: "Appartement A", "Chambre 1"
  type        RentalType
  status      RentalStatus @default(AVAILABLE)
  roomCount   Int          @default(1)
  rentalValue Float // Valeur locative de base
  charges     Float        @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contracts Contract[]
  expenses  Expense[]

  @@map("rentals")
}

model Contract {
  id                 Int            @id @default(autoincrement())
  ownerId            Int
  propertyId         Int
  rentalId           Int
  tenantId           Int
  managerId          Int? // Changé en optionnel pour la flexibilité
  rentDeposit        Int // Caution (nombre de mois)
  rentAdvance        Int // Avance (nombre de mois)
  startDate          DateTime
  endDate            DateTime?
  dayAddToPaymentDay Int            @default(1)
  paymentStartAfter  Int            @default(1)
  rentAmount         Float // Montant négocié dans le contrat
  depositAmount      Float // Montant total de la caution versée
  leaseType          LeaseType      @default(RESIDENTIAL_LEASE)
  status             ContractStatus @default(PENDING)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  owner    Owner     @relation(fields: [ownerId], references: [id])
  property Property  @relation(fields: [propertyId], references: [id])
  rental   Rental    @relation(fields: [rentalId], references: [id])
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  manager  Manager? @relation("ContractManager", fields: [managerId], references: [id])
  invoices Invoice[]

  @@map("contracts")
}

// ============================================================================
// FINANCES
// ============================================================================

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique
  contractId    Int
  tenantId      Int
  amountDue     Float
  paidAmount    Float         @default(0)
  type          InvoiceType
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime
  paidDate      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  contract     Contract             @relation(fields: [contractId], references: [id])
  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  transactions PaymentTransaction[]

  @@map("invoices")
}

model PaymentTransaction {
  id          Int                      @id @default(autoincrement())
  invoiceId   Int
  provider    PaymentProvider
  providerRef String?                  @unique
  amount      Float
  status      PaymentTransactionStatus @default(PENDING)
  rawPayload  Json?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model Expense {
  id           Int           @id @default(autoincrement())
  propertyId   Int
  rentalId     Int?
  recordedById Int
  amount       Float
  description  String
  date         DateTime
  type         ExpenseType
  status       ExpenseStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  property   Property @relation(fields: [propertyId], references: [id])
  rental     Rental?  @relation(fields: [rentalId], references: [id])
  recordedBy User     @relation("UserExpenses", fields: [recordedById], references: [id])

  @@map("expenses")
}
