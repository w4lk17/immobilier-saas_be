// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================
enum UserRole {
  USER
  OWNER
  TENANT
  MANAGER
  ADMIN // Admin d'une Organisation (Client)
  SUPER_ADMIN // admin de la plateforme Hofeti
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum EmploymentType {
  CDI
  CDD
  INTERIM
  STAGE
  OTHER
}

enum PropertyType {
  APARTMENT
  BUILDING
  BUNGALOW
  DUPLEX
  HOUSE
  LAND
  VILLA
  OTHER
}

enum PropertyStatus {
  AVAILABLE
  FOR_RENT
  MAINTENANCE
  UNAVAILABLE
}

enum RentalType {
  STUDIO
  STORE
  APARTMENT
  VILLA
  SINGLE_ROOM
}

enum RentalStatus {
  AVAILABLE
  BOOKED
  OCCUPIED
  MAINTENANCE
}

enum LeaseType {
  COMMERCIAL_LEASE
  RESIDENTIAL_LEASE
  OTHER
}

enum ContractStatus {
  PENDING
  ACTIVE
  TERMINATED
  EXPIRED
}

enum InvoiceType {
  RENT
  DEPOSIT
  CHARGES
  PENALTY
  ADVANCE
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

enum PaymentProvider {
  STRIPE
  MOBILE_MONEY
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILURE
  CANCELLED
}

enum ExpenseType {
  MAINTENANCE
  REPAIR
  TAX
  INSURANCE
  UTILITY
  OTHER
}

enum ExpenseStatus {
  PENDING
  PAID
  CANCELED
}

enum NotificationType {
  INVOICE_GENERATED           // Facture générée
  INVOICE_PAID                // Facture payée
  INVOICE_OVERDUE             // Facture en retard
  INVOICE_EXPIRED             // Facture expirée
  INVOICE_CANCELLED           // Facture annulée
  INVOICE_SENT                // Facture envoyée
  WELCOME                     // Bienvenue après inscription
  SYSTEM                      // Notification système générale
}

// ==========================================
// SAAS CORE
// ==========================================

model Plan {
  id             Int     @id @default(autoincrement())
  name           String  @unique // "Basique", "Standard", "Pro"
  slug           String  @unique // "basic", "standard"...
  price          Int // Prix en FCFA
  maxContracts   Int     @default(5)
  maxUsers       Int     @default(1)
  hasAutoInvoice Boolean @default(false)
  hasSms         Boolean @default(false)

  organizations Organization[]
}

model Organization {
  id               Int     @id @default(autoincrement())
  name             String // Nom de l'agence ou du propriÃƒÂ©taire
  email            String  @unique
  phone            String? @unique
  isEmailVerified  Boolean @default(false)
  emailVerifyToken String? @unique
  isPhoneVerified  Boolean @default(false)
  phoneVerifyCode  String?

  // Abonnement
  planId             Int
  plan               Plan               @relation(fields: [planId], references: [id])
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime           @default(now())
  subscriptionEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                    User[]
  contracts                Contract[]
  properties               Property[]
  invoices                 Invoice[]
  expenses                 Expense[]
  notifications            Notification[]
  invoiceGenerationHistory InvoiceGenerationHistory[]

  @@map("organizations")
}

// ==========================================
// USER
// ==========================================

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  role     UserRole @default(USER)

  // Champs Communs
  firstName   String
  lastName    String
  phoneNumber String? @unique
  isPhoneVerified Boolean @default(false)
  phoneVerifyCode String?
  phoneVerifyExpiresAt DateTime?
  phoneOtpLastSentAt DateTime?
  civility    String?
  dateOfBirth DateTime?
  address     String?
  pictureUrl  String?
  workPlace   String?
  occupation  String?

  // Documents
  identityDocumentNumber String?
  identityDocumentType   String?
  identityDeliveryCity   String?
  identityDeliveryDate   DateTime?
  identityExpiryDate     DateTime?

  // PAC
  pacLastName    String?
  pacFirstName   String?
  pacPhoneNumber String?

  // Système
  isActive     Boolean  @default(true)
  refreshToken String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- RELATIONS ---
  organizationId Int
  organization   Organization   @relation(fields: [organizationId], references: [id])
  notifications  Notification[]
  // Profils
  ownerProfile   Owner?
  managerProfile Manager?
  tenantProfile  Tenant?

  recordedExpenses Expense[] @relation("UserExpenses")

  @@map("users")
}

// ==========================================
// PROFILES
// ==========================================

model Owner {
  id     Int @id @default(autoincrement())
  userId Int @unique

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts  Contract[]
  properties Property[]

  @@map("owners")
}

model Manager {
  id     Int @id @default(autoincrement())
  userId Int @unique

  position        String
  hireDate        DateTime       @default(now())
  terminationDate DateTime?
  employmentType  EmploymentType @default(CDI)

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedProperties Property[] @relation("PropertyManager")
  managedContracts  Contract[] @relation("ContractManager")

  @@map("managers")
}

model Tenant {
  id     Int @id @default(autoincrement())
  userId Int @unique

  oldAddress String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts Contract[]
  invoices  Invoice[]

  @@map("tenants")
}

// ==========================================
// REAL ESTATE
// ==========================================

model Property {
  id            Int            @id @default(autoincrement())
  ownerId       Int
  managerId     Int?
  address       String
  description   String?        @db.Text
  type          PropertyType
  propertyValue Float?
  rentalUnits   Int            @default(1)
  status        PropertyStatus @default(AVAILABLE)

  isForSale    Boolean  @default(false)
  nLot         Int?
  lot          Int?
  landTitle    String?
  surface      Float?
  name         String?
  city         String?
  neighborhood String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- NOUVEAU : Lien Organisation ---
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  // -----------------------------------

  owner   Owner    @relation(fields: [ownerId], references: [id])
  manager Manager? @relation("PropertyManager", fields: [managerId], references: [id])

  rentals   Rental[]
  contracts Contract[]
  expenses  Expense[]

  @@map("properties")
}

model Rental {
  id          Int          @id @default(autoincrement())
  propertyId  Int
  name        String
  type        RentalType
  status      RentalStatus @default(AVAILABLE)
  roomCount   Int          @default(1)
  surface     Float
  isFurnished Boolean      @default(false)
  rentalValue Float
  charges     Float        @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contracts Contract[]
  expenses  Expense[]

  @@map("rentals")
}

model Contract {
  id                 Int     @id @default(autoincrement())
  ownerId            Int
  propertyId         Int
  rentalId           Int
  tenantId           Int
  managerId          Int?
  reference          String?
  // -------------------------------------
  rentAmount         Float
  chargesAmount      Float   @default(0)
  depositAmount      Float   @default(0)
  advanceAmount      Float   @default(0)
  rentDeposit        Int     @default(1)
  rentAdvance        Int     @default(0)
  paymentStartAfter  Int     @default(0)
  dayAddToPaymentDay Int     @default(1)

  startDate DateTime
  endDate   DateTime?
  leaseType LeaseType      @default(RESIDENTIAL_LEASE)
  status    ContractStatus @default(PENDING)
  pdfUrl    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // --- NOUVEAU : Lien Organisation ---
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  // -----------------------------------

  owner    Owner    @relation(fields: [ownerId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  rental   Rental   @relation(fields: [rentalId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  manager  Manager? @relation("ContractManager", fields: [managerId], references: [id])

  invoices Invoice[]

  @@unique([organizationId, reference])
  @@map("contracts")
}

// ==========================================
// FINANCES
// ==========================================

model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique
  contractId     Int
  tenantId       Int
  amountDue      Float
  paidAmount     Float         @default(0)
  type           InvoiceType
  status         InvoiceStatus @default(PENDING)
  dueDate        DateTime
  paidDate       DateTime?
  organizationId Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // --- NOUVEAU : Lien Organisation ---
  organization Organization @relation(fields: [organizationId], references: [id])
  // -----------------------------------

  contract     Contract             @relation(fields: [contractId], references: [id])
  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  transactions PaymentTransaction[]

  @@map("invoices")
}

model PaymentTransaction {
  id          Int                      @id @default(autoincrement())
  invoiceId   Int
  provider    PaymentProvider
  providerRef String?                  @unique
  amount      Float
  status      PaymentTransactionStatus @default(PENDING)
  rawPayload  Json?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model Expense {
  id           Int           @id @default(autoincrement())
  propertyId   Int
  rentalId     Int?
  recordedById Int
  amount       Float
  description  String
  date         DateTime
  type         ExpenseType
  status       ExpenseStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // --- NOUVEAU : Lien Organisation ---
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  // -----------------------------------

  property   Property @relation(fields: [propertyId], references: [id])
  rental     Rental?  @relation(fields: [rentalId], references: [id])
  recordedBy User     @relation("UserExpenses", fields: [recordedById], references: [id])

  @@map("expenses")
}

// ==========================================
// NOTIFICATIONS IN APP 
// ==========================================

model Notification {
  id             Int              @id @default(autoincrement())
  organizationId Int
  userId         Int
  type           NotificationType @default(SYSTEM)
  title          String // Titre court de la notification
  message        String // Message dÃƒÂ©taillÃƒÂ©
  link           String? // Lien interne (ex: /invoices/xxx)
  read           Boolean          @default(false) // Notification lue ?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ==========================================
// INVOICE GENERATION HISTORY
// ==========================================
model InvoiceGenerationHistory {
  id             Int          @id @default(autoincrement())
  organizationId Int
  periodStart    DateTime
  periodEnd      DateTime
  status         String // SUCCESS, FAILED
  details        String? // log, erreur ÃƒÂ©ventuelle
  generatedAt    DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("invoice_generation_history")
}


